##define virtual network mask
VirtualAddrNetwork 10.192.0.0/10
AutomapHostsOnResolve 1
AutomapHostsSuffixes .exit,.onion

#define tor ports and explicitly declare some security flags
TransPort 127.0.0.1:9140 KeepAliveIsolateSOCKSAuth IsolateClientProtocol IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
SocksPort 127.0.0.1:9150 KeepAliveIsolateSOCKSAuth IsolateClientProtocol IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
TransPort 127.0.0.1:9040 KeepAliveIsolateSOCKSAuth IsolateClientProtocol IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
SocksPort 127.0.0.1:9050 KeepAliveIsolateSOCKSAuth IsolateClientProtocol IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
ControlPort 127.0.0.1:9051
CookieAuthentication 1
ControlPort 127.0.0.1:9151
CookieAuthentication 1
#use tor to resolve domain names
DNSPort 127.0.0.1:53

#daemonize
RunAsDaemon 1

#use hardware accaleration when possible for crypto
HardwareAccel 1

#socket safety hacks
TestSocks 1
AllowNonRFC953Hostnames 0

# DNS safety hacks. Both are enabled by default, according to Tor's doc. However, we should define it here to make everything be clear
ClientDNSRejectInternalAddresses 1
ClientRejectInternalAddresses 1

#circuit hacks
MaxCircuitDirtiness 600
MaxClientCircuitsPending 96
UseEntryGuards 1
EnforceDistinctSubnets 1

# Set cookie authentication
CookieAuthentication 1
CookieAuthFile /var/run/tor/control.authcookie

# Use sandbox
Sandbox 0

# Bridge setting: No bridge

# Use SafeSocks
SafeSocks 0

HiddenServiceDir /var/lib/tor/sshd
HiddenServicePort 22 127.0.0.1:22

HiddenServiceDir /var/lib/tor/artirat-server
HiddenServicePort 1337 127.0.0.1:1337
